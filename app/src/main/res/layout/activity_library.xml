<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:elevation="0dp"
        app:backgroundTint="@color/black"
        app:elevation="0dp"
        app:liftOnScroll="false"
        app:liftOnScrollColor="@color/black"
        app:statusBarForeground="@color/black">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Padded section for Header & Search Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="0dp">

                <!-- Selection Mode Header (visible only during multi-selection) -->
                <LinearLayout
                    android:id="@+id/layout_selection_header"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageButton
                        android:id="@+id/btn_close_selection"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_glass_button"
                        android:contentDescription="Tutup Seleksi"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_close"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tv_selection_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="1 dipilih" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_select_all"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Pilih Semua"
                        android:textColor="@color/secondary"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btn_delete_selected"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_control_circle"
                        android:backgroundTint="#26FF5252"
                        android:contentDescription="Hapus Video Terpilih"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_delete"
                        app:tint="#FF5252" />
                </LinearLayout>

                <!-- Top Header: Title & Folder Action -->
                <LinearLayout
                    android:id="@+id/layout_normal_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="@string/app_name"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btn_search"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_glass_button"
                        android:contentDescription="@string/search_hint"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_search"
                        app:tint="@color/white" />

                    <ImageButton
                        android:id="@+id/btn_sort"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_glass_button"
                        android:contentDescription="@string/sort_by"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_sort"
                        app:tint="@color/white" />
                </LinearLayout>

                <!-- iOS Style Search Capsule Field Container -->
                <FrameLayout
                    android:id="@+id/container_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:clipChildren="true">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_search"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:boxCornerRadiusBottomEnd="22dp"
                        app:boxCornerRadiusBottomStart="22dp"
                        app:boxCornerRadiusTopEnd="22dp"
                        app:boxCornerRadiusTopStart="22dp"
                        app:boxBackgroundColor="#1C1C1E"
                        app:boxStrokeColor="@android:color/transparent"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:endIconMode="clear_text"
                        app:endIconTint="#8E8E93"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/ic_search"
                        app:startIconTint="#8E8E93">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_search"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:hint="@string/search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:textColor="@color/white"
                            android:textColorHint="#8E8E93"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- iOS Segmented Capsule Control Switcher: Semua Video vs Folder -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_ios_segmented_container"
                android:padding="3dp">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    app:tabBackground="@android:color/transparent"
                    app:tabGravity="fill"
                    app:tabMode="fixed"
                    app:tabInlineLabel="true"
                    app:tabIconTint="@color/tab_color_selector_ios"
                    app:tabIndicator="@drawable/bg_ios_segmented_indicator"
                    app:tabIndicatorGravity="stretch"
                    app:tabIndicatorColor="@color/white"
                    app:tabIndicatorAnimationMode="elastic"
                    app:tabIndicatorAnimationDuration="280"
                    app:tabIndicatorFullWidth="true"
                    app:tabSelectedTextColor="#000000"
                    app:tabTextColor="#8E8E93"
                    app:tabRippleColor="@null" />
            </FrameLayout>

            <!-- Kept for backward compatibility with selection mode toggling -->
            <View
                android:id="@+id/tab_divider"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <!-- 1. All Videos Flat List (Vertical) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_all_videos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:visibility="visible"
            tools:listitem="@layout/item_episode" />

        <!-- 2. Folder List (Vertical) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_series"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:visibility="gone"
            tools:listitem="@layout/item_anime_series" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/iv_empty_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tidak Ada Video"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Tidak ada video ditemukan di penyimpanan perangkat."
                android:textColor="@color/on_surface_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_all_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/primary"
                    android:text="Pindai Ulang"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Floating Scroll-To-Top Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_scroll_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="Langsung ke paling atas"
        android:src="@drawable/ic_arrow_upward"
        android:visibility="gone"
        app:backgroundTint="#1E293B"
        app:borderWidth="1.5dp"
        app:elevation="6dp"
        app:fabCustomSize="46dp"
        app:maxImageSize="22dp"
        app:rippleColor="#4038BDF8"
        app:strokeColor="@color/secondary"
        app:tint="@color/secondary" />

    <!-- Alphabet Fast Scroll Bar (A-Z) (Dynamically centered between tab divider and bottom) -->
    <com.personal.animeplayer.ui.library.AlphabetIndexView
        android:id="@+id/alphabet_index_view"
        android:layout_width="22dp"
        android:layout_height="440dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="4dp"
        android:visibility="gone" />

    <!-- Floating Alphabet Preview Bubble -->
    <TextView
        android:id="@+id/tv_alphabet_bubble"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_alphabet_bubble"
        android:gravity="center"
        android:textColor="@color/secondary"
        android:textSize="30sp"
        android:textStyle="bold"
        android:elevation="12dp"
        android:visibility="gone" />

    <!-- Cinematic Splash / Intro Loading Overlay (Netflix / Apple TV Style) -->
    <FrameLayout
        android:id="@+id/layout_splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0E0F12"
        android:clickable="true"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="100dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- Logo with Ambient Glow Aura -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:id="@+id/view_splash_glow"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_splash_glow"
                    android:alpha="0" />

                <ImageView
                    android:id="@+id/iv_splash_logo"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_app_logo"
                    android:contentDescription="Giplay Logo" />
            </FrameLayout>

            <!-- Brand Title -->
            <TextView
                android:id="@+id/tv_splash_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <!-- Brand Subtitle / Tagline -->
            <TextView
                android:id="@+id/tv_splash_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ultra Video Player"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:letterSpacing="0.12" />

            <!-- Glowing Capsule Progress Bar -->
            <FrameLayout
                android:id="@+id/layout_splash_progress_container"
                android:layout_width="140dp"
                android:layout_height="5dp"
                android:layout_marginTop="28dp"
                android:clipToOutline="true"
                android:background="@drawable/bg_splash_progress_track">

                <View
                    android:id="@+id/view_splash_progress_bar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_splash_progress_fill" />
            </FrameLayout>

        </LinearLayout>

        <!-- Bottom Version / Slogan Stamp -->
        <TextView
            android:id="@+id/tv_splash_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="36dp"
            android:text="Fast • Pure • Immersive"
            android:textColor="#707585"
            android:textSize="11sp"
            android:letterSpacing="0.15" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
