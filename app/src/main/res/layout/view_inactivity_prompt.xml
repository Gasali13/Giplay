<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_inactivity_prompt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:maxWidth="440dp"
        android:background="@drawable/bg_glass_dialog"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Sleep Icon with soft glow -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle_icon_glow">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bedtime"
                app:tint="#A5B4FC" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tv_prompt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Masih Nonton?"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:id="@+id/tv_prompt_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Pemutaran telah berjalan selama 60 menit tanpa sentuhan layar. Aplikasi akan keluar otomatis dalam 30 detik untuk menghemat baterai."
            android:textColor="#C7D2FE"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <!-- Countdown Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_countdown"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="18dp"
            android:max="30"
            android:progress="30"
            app:indicatorColor="#818CF8"
            app:trackColor="#26FFFFFF"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

        <!-- Countdown Text -->
        <TextView
            android:id="@+id/tv_countdown_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Otomatis keluar dalam 30 detik"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Action Button (Single Prominent Lanjut Nonton Button) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continue_watching"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Lanjut Nonton"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_play_arrow"
            app:iconTint="@color/white"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:cornerRadius="24dp"
            app:backgroundTint="#4F46E5"
            app:rippleColor="#806366F1" />

    </LinearLayout>

</FrameLayout>
