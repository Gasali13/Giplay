<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- Left Half (Rewind) -->
    <FrameLayout
        android:id="@+id/container_rewind"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:visibility="invisible">

        <LinearLayout
            android:id="@+id/content_rewind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_rewind_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:shadowColor="#E6000000"
                android:shadowRadius="10"
                android:shadowDx="0"
                android:shadowDy="2"
                android:text="-10 Detik" />
        </LinearLayout>
    </FrameLayout>

    <!-- Right Half (Forward) -->
    <FrameLayout
        android:id="@+id/container_forward"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:visibility="invisible">

        <LinearLayout
            android:id="@+id/content_forward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_forward_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:shadowColor="#E6000000"
                android:shadowRadius="10"
                android:shadowDx="0"
                android:shadowDy="2"
                android:text="+10 Detik" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
