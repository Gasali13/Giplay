# Salin file ini menjadi `keystore.properties` (jangan di-commit ke Git)
# lalu isi dengan kredensial keystore rilis Anda.
#
# Contoh membuat keystore baru lewat terminal:
# keytool -genkeypair -v -keystore giplay-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias giplay

storeFile=giplay-release.jks
storePassword=CHANGE_ME
keyAlias=giplay
keyPassword=CHANGE_ME
